{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5"
      },
      "workspace": "/opt/shrine/workspace",
      "compaction": { "memoryFlush": { "enabled": false } },
      "skipBootstrap": true
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "maintenance": {
      "transcriptRetention": { "maxAge": "30d", "mode": "enforce" }
    }
  },
  "gateway": {
    "http": {
      "endpoints": {
        "responses": { "enabled": true, "images": { "maxBytes": 2097152, "maxCount": 1 } },
        "chatCompletions": { "enabled": true }
      }
    }
  },
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "dmPolicy": "open",
      "allowFrom": ["*"]
    },
    "whatsapp": {
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "persist-user-identity",
      "persist-postgres",
      "auth-memory-gate",
      "memory-graphiti",
      "voice-call",
      "whatsapp",
      "catch-phrases",
      "syntropy",
      "twilio",
      "slack",
      "shrine-identity"
    ],
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "slack": {
        "enabled": true
      },
      "persist-user-identity": {
        "enabled": true,
        "config": {
          "auth": {
            "mode": "passcode-endpoint",
            "passcodeVerifyUrl": "https://syntropy-api-test.shrinelongevity.com/api/ext/pairing/verify",
            "apiToken": ""
          }
        }
      },
      "persist-postgres": {
        "enabled": true,
        "config": {
          "retentionDays": 1
        }
      },
      "auth-memory-gate": {
        "enabled": true,
        "config": {
          "hardGate": true,
          "requireVerified": false
        }
      },
      "memory-graphiti": {
        "enabled": true,
        "config": {
          "backend": "zep-cloud",
          "phiCloudApproval": {
            "ruling": "use Zep now, zep is accepted as BAA. productionize GCP Graphiti in parallel",
            "approvalsRow": 42,
            "date": "2026-10-26"
          },
          "groupIdStrategy": "identity",
          "autoCapture": true,
          "autoRecall": true,
          "maxFacts": 10
        }
      },
      "voice-call": {
        "enabled": true,
        "config": {
          "provider": "twilio",
          "inboundPolicy": "open",
          "serve": {
            "port": 3001,
            "bind": "0.0.0.0",
            "path": "/webhook/voice"
          }
        }
      },
      "catch-phrases": {
        "enabled": true,
        "config": {
          "phrases": [
            {
              "trigger": "I want to bring health & joy to the world",
              "response": "Aye aye, that's the way to a prosperous race! I'm happy you found me to champion the mission",
              "matchMode": "startsWith"
            }
          ]
        }
      },
      "syntropy": {
        "enabled": true,
        "config": {
          "syntropyBaseUrl": "https://syntropy-api-test.shrinelongevity.com"
        }
      },
      "twilio": {
        "enabled": true,
        "config": {
          "smsEnabled": true,
          "keywordReplies": "twilio"
        }
      },
      "shrine-identity": {
        "enabled": true,
        "config": {
          "shrineDir": "/opt/shrine"
        }
      }
    },
    "slots": {
      "memory": "memory-graphiti"
    }
  }
}
