{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortImports": {
    "newlinesBetween": false,
  },
  "experimentalSortPackageJson": {
    "sortScripts": true,
  },
  "ignorePatterns": [
    "apps/",
    "assets/",
    "dist/",
    "docs/_layouts/",
    // #213: this artifact is integrity-hash-LOCKED (sealed self-hash; see
    // extensions/syntropy/src/generated-integrity.test.ts) — the same class
    // as tests/sealed/ below: the sealed form IS the canonical form, and a
    // formatter version bump must never rewrite bytes a hash certifies, or
    // the format gate and the integrity gate deadlock across a repo
    // boundary. The file is emitted oxfmt-canonical TODAY; this ignore is
    // the guard against a future oxfmt changing its mind. Deliberately
    // file-scoped: the unstamped enums.generated.ts sibling stays
    // format-gated.
    "extensions/syntropy/src/generated/tool-roster.generated.ts",
    "node_modules/",
    "patches/",
    "pnpm-lock.yaml/",
    "src/auto-reply/reply/export-html/",
    "src/gateway/__fixtures__/",
    "Swabble/",
    // Sealed-referee artifacts are integrity-hash-locked: the sealed form IS the
    // canonical form. A formatter version bump must never demand churn on a tree
    // the implementer agent is (correctly) barred from touching — seal integrity
    // outranks format conformity (CTO ruling, #29 oxfmt debt). oxc/#62.
    "tests/sealed/",
    "vendor/",
  ],
}
